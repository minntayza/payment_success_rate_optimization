# Anthropic-compatible MiMo endpoint configuration.
ANTHROPIC_BASE_URL=https://your-provider.example
ANTHROPIC_API_KEY=replace-with-your-api-key
ANTHROPIC_MODEL=mimo-2.5-pro

# MongoDB Atlas and administrator configuration.
MONGODB_URI=mongodb+srv://app-user:password@cluster.example.mongodb.net/
MONGODB_DATABASE=payment
ADMIN_PASSWORD_HASH=pbkdf2_sha256$600000$replace-salt$replace-derived-key

# Web application authentication. Never use the local demo credentials in a
# deployed environment. WEB_AUTH_SECRET should be a long, random value.
WEB_AUTH_SECRET=replace-with-a-long-random-secret
WEB_USER_EMAIL=analyst@example.com
WEB_USER_PASSWORD=replace-with-a-strong-user-password
WEB_ADMIN_EMAIL=admin@example.com
WEB_ADMIN_PASSWORD=replace-with-a-strong-admin-password
WEB_ALLOWED_ORIGINS=http://localhost:3000
