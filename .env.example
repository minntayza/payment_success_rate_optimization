# Anthropic-compatible MiMo endpoint configuration.
ANTHROPIC_BASE_URL=https://your-provider.example
ANTHROPIC_API_KEY=replace-with-your-api-key
ANTHROPIC_MODEL=mimo-2.5-pro

# Public runtime Supabase configuration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-anon-key

# Use only for the local one-time importer. Never add this to Streamlit Cloud.
SUPABASE_SERVICE_ROLE_KEY=local-import-only
